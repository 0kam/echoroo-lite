{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echoroo Lite",
  "version": "0.1.0",
  "identifier": "org.echoroo.lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../web/build"
  },
  "app": {
    "windows": [{"title": "Echoroo Lite", "width": 1280, "height": 900, "minWidth": 800, "minHeight": 600}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; media-src http://127.0.0.1:*; img-src 'self' data: http://127.0.0.1:*"
    }
  },
  "bundle": {"active": false, "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]}
}
